#!/bin/bash
#
# APEX Dante Start Script
# Usage: ./start_dante [options]
#
# Options:
#   up      Start APEX (default)
#   down    Stop APEX
#   restart Restart APEX
#   logs    Show logs
#   status  Show status
#

set -e

COMPOSE_FILE="docker/docker-compose.prod.yml"
PROJECT_NAME="apex"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

show_status() {
    docker compose -f "$COMPOSE_FILE" ps
}

case "${1:-up}" in
    up)
        log_info "Starting APEX..."
        docker compose -f "$COMPOSE_FILE" up -d
        log_info "Waiting for APEX to be ready..."
        sleep 3
        if curl -sf http://localhost:3000/health > /dev/null 2>&1; then
            log_info "APEX is running!"
            log_info "Router:  http://localhost:3000"
            log_info "UI:     http://localhost:8083"
        else
            log_warn "APEX started but health check failed. Check logs with: ./start_dante logs"
        fi
        ;;
    down)
        log_info "Stopping APEX..."
        docker compose -f "$COMPOSE_FILE" down
        log_info "APEX stopped."
        ;;
    restart)
        log_info "Restarting APEX..."
        docker compose -f "$COMPOSE_FILE" restart
        log_info "APEX restarted."
        ;;
    logs)
        docker compose -f "$COMPOSE_FILE" logs -f --tail=50
        ;;
    status)
        show_status
        ;;
    pull)
        log_info "Pulling latest images..."
        docker compose -f "$COMPOSE_FILE" pull
        log_info "Images updated."
        ;;
    build)
        log_info "Building APEX..."
        docker compose -f "$COMPOSE_FILE" build
        log_info "APEX built."
        ;;
    *)
        echo "APEX Dante - Simple deployment script"
        echo ""
        echo "Usage: ./start_dante [command]"
        echo ""
        echo "Commands:"
        echo "  up       Start APEX (default)"
        echo "  down     Stop APEX"
        echo "  restart  Restart APEX"
        echo "  logs     Show logs"
        echo "  status   Show status"
        echo "  pull     Pull latest images"
        echo "  build    Build images"
        echo ""
        show_status
        ;;
esac