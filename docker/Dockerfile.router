FROM rust:1.75-bookworm AS builder

WORKDIR /build

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY core core/
COPY -k

# Build release binary
RUN cargo build --release --bin apex-router

# Final stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy binary from builder
COPY --from=builder /build/target/release/apex-router /app/apex-router

# Create data directory
RUN mkdir -p /data

# Set environment
ENV APEX_PORT=3000
ENV APEX_DATABASE_URL=sqlite:/data/apex.db
ENV APEX_USE_LLM=0

EXPOSE 3000

USER apex

ENTRYPOINT ["/app/apex-router"]